# 8-Puzzle using DFS and IDS

# Goal state
GOAL = (1, 2, 3,
        4, 5, 6,
        7, 8, 0)


# ---------------------------------------------------
# Generate possible moves
# ---------------------------------------------------

def get_neighbors(state):

    neighbors = []

    zero_index = state.index(0)

    row = zero_index // 3
    col = zero_index % 3

    # Up
    if row > 0:
        new_state = list(state)
        swap_index = zero_index - 3
        new_state[zero_index], new_state[swap_index] = \
            new_state[swap_index], new_state[zero_index]

        neighbors.append(tuple(new_state))

    # Down
    if row < 2:
        new_state = list(state)
        swap_index = zero_index + 3
        new_state[zero_index], new_state[swap_index] = \
            new_state[swap_index], new_state[zero_index]

        neighbors.append(tuple(new_state))

    # Left
    if col > 0:
        new_state = list(state)
        swap_index = zero_index - 1
        new_state[zero_index], new_state[swap_index] = \
            new_state[swap_index], new_state[zero_index]

        neighbors.append(tuple(new_state))

    # Right
    if col < 2:
        new_state = list(state)
        swap_index = zero_index + 1
        new_state[zero_index], new_state[swap_index] = \
            new_state[swap_index], new_state[zero_index]

        neighbors.append(tuple(new_state))

    return neighbors


# ---------------------------------------------------
# DFS
# ---------------------------------------------------

def dfs(initial, goal):

    stack = [(initial, 0)]
    visited = set()

    while stack:

        current, depth = stack.pop()

        if current == goal:
            return depth

        if current in visited:
            continue

        visited.add(current)

        for next_state in get_neighbors(current):

            if next_state not in visited:
                stack.append((next_state, depth + 1))

    return None


# ---------------------------------------------------
# Depth Limited Search for IDS
# ---------------------------------------------------

def depth_limited_search(state, goal, limit, visited):

    if state == goal:
        return 0

    if limit == 0:
        return None

    visited.add(state)

    for next_state in get_neighbors(state):

        if next_state not in visited:

            result = depth_limited_search(
                next_state,
                goal,
                limit - 1,
                visited
            )

            if result is not None:
                return result + 1

    visited.remove(state)

    return None


# ---------------------------------------------------
# IDS
# ---------------------------------------------------

def ids(initial, goal):

    depth = 0

    while True:

        visited = set()

        result = depth_limited_search(
            initial,
            goal,
            depth,
            visited
        )

        if result is not None:
            return result

        depth += 1


# ---------------------------------------------------
# Main Program
# ---------------------------------------------------

print("8-PUZZLE SOLVER")
print("----------------")

print("\nEnter initial state:")
print("Enter 0 for the blank space.")

initial = []

for i in range(9):
    value = int(input(f"Enter element {i + 1}: "))
    initial.append(value)

initial = tuple(initial)


# ---------------------------------------------------
# DFS
# ---------------------------------------------------

print("\n==============================")
print("DFS SOLUTION")
print("==============================")

dfs_solution = dfs(initial, GOAL)

if dfs_solution is None:
    print("No solution found using DFS.")
else:
    print("Solution found using DFS.")
    print("Number of moves:", dfs_solution)


# ---------------------------------------------------
# IDS
# ---------------------------------------------------

print("\n==============================")
print("IDS SOLUTION")
print("==============================")

ids_solution = ids(initial, GOAL)

if ids_solution is None:
    print("No solution found using IDS.")
else:
    print("Solution found using IDS.")
    print("Number of moves:", ids_solution)
