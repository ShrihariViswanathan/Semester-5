
import random
import math

# Calculate cost (number of attacking pairs)
def calculate_cost(state):
    cost = 0

    for i in range(8):
        for j in range(i + 1, 8):
            if abs(state[i] - state[j]) == abs(i - j):
                cost += 1

    return cost


# Generate neighbour by swapping two queens
def get_neighbour(state):
    new_state = state.copy()

    i, j = random.sample(range(8), 2)

    new_state[i], new_state[j] = new_state[j], new_state[i]

    return new_state


# Simulated Annealing Algorithm
def simulated_annealing():

    for restart in range(100):

        # Random initial state
        current = random.sample(range(8), 8)

        T = 10

        while T > 0.01:

            current_cost = calculate_cost(current)

            if current_cost == 0:
                print("\nSolution Found!")
                return current

            next_state = get_neighbour(current)
            next_cost = calculate_cost(next_state)

            delta = current_cost - next_cost

            # Accept better state
            if delta > 0:
                current = next_state

            # Accept worse state with probability
            else:
                probability = math.exp(delta / T)

                if random.random() < probability:
                    current = next_state

            # Reduce temperature
            T = T * 0.995

    return None


# Main program
solution = simulated_annealing()

if solution is not None:

    print("Final State:", solution)
    print("Final Cost:", calculate_cost(solution))

    print("\nChessboard:")

    for row in range(8):
        for col in range(8):
            if solution[col] == row:
                print("Q", end=" ")
            else:
                print(".", end=" ")
        print()

else:
    print("Solution not found. Run again.")
