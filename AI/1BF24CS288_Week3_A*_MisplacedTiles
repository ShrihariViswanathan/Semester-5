import heapq


GOAL = (1, 2, 3,
        4, 5, 6,
        7, 8, 0)


def misplaced_tiles(state):
    """Count tiles that are not in their goal position, excluding 0."""
    return sum(
        1 for index, tile in enumerate(state)
        if tile != 0 and tile != GOAL[index]
    )


def get_neighbors(state):
    neighbors = []
    zero_index = state.index(0)
    row = zero_index // 3
    col = zero_index % 3

    moves = []
    if row > 0:
        moves.append(zero_index - 3)  # Up
    if row < 2:
        moves.append(zero_index + 3)  # Down
    if col > 0:
        moves.append(zero_index - 1)  # Left
    if col < 2:
        moves.append(zero_index + 1)  # Right

    for swap_index in moves:
        new_state = list(state)
        new_state[zero_index], new_state[swap_index] = \
            new_state[swap_index], new_state[zero_index]
        neighbors.append(tuple(new_state))

    return neighbors


def a_star(initial):
    # Each queue item contains (f, g, state), where f = g + h.
    frontier = [(misplaced_tiles(initial), 0, initial)]
    best_depth = {initial: 0}
    parent = {initial: None}

    while frontier:
        _, depth, current = heapq.heappop(frontier)

        if depth != best_depth[current]:
            continue

        if current == GOAL:
            path = []
            while current is not None:
                path.append(current)
                current = parent[current]
            return path[::-1]

        for next_state in get_neighbors(current):
            next_depth = depth + 1

            if next_depth < best_depth.get(next_state, float("inf")):
                best_depth[next_state] = next_depth
                parent[next_state] = current
                heuristic = misplaced_tiles(next_state)
                heapq.heappush(
                    frontier,
                    (next_depth + heuristic, next_depth, next_state)
                )

    return None


def print_board(state):
    for row in range(3):
        cells = state[row * 3:(row + 1) * 3]
        print(" ".join("_" if tile == 0 else str(tile) for tile in cells))


def is_solvable(state):
    tiles = [tile for tile in state if tile != 0]
    inversions = sum(
        1 for first in range(len(tiles))
        for second in range(first + 1, len(tiles))
        if tiles[first] > tiles[second]
    )
    return inversions % 2 == 0


print("8-PUZZLE SOLVER USING A* SEARCH")
print("Enter the tiles 0 to 8, with 0 for the empty space.")

while True:
    try:
        initial = tuple(
            int(input(f"Enter element {index + 1}: "))
            for index in range(9)
        )
        if sorted(initial) != list(range(9)):
            print("Enter each number from 0 to 8 exactly once.")
            continue
        break
    except ValueError:
        print("Please enter integer values from 0 to 8.")

if not is_solvable(initial):
    print("This puzzle cannot be solved.")
else:
    solution = a_star(initial)

    if solution is None:
        print("No solution found.")
    else:
        print(f"\nSolution found in {len(solution) - 1} moves.")
        for depth, state in enumerate(solution):
            heuristic = misplaced_tiles(state)
            print(f"\nStep {depth}: g(n)={depth}, h(n)={heuristic}, f(n)={depth + heuristic}")
            print_board(state)
