
# Hill Climbing Algorithm for 4 Queens Problem

# Calculate the number of attacking pairs
def calculate_cost(state):
    cost = 0

    for i in range(4):
        for j in range(i + 1, 4):

            # Same row or diagonal attack
            if state[i] == state[j] or abs(state[i] - state[j]) == abs(i - j):
                cost += 1

    return cost


# Generate neighbour states by swapping two queens
def get_neighbours(state):
    neighbours = []

    for i in range(4):
        for j in range(i + 1, 4):
            new_state = list(state)

            # Swap row positions
            new_state[i], new_state[j] = new_state[j], new_state[i]

            neighbours.append((tuple(new_state), (i, j)))

    return neighbours


# Hill Climbing Algorithm
def hill_climbing():

    # Initial state given in the PPT
    current = (3, 1, 2, 0)

    while True:

        current_cost = calculate_cost(current)

        print("\nCurrent State:", current)
        print("Current Cost:", current_cost)

        if current_cost == 0:
            print("\nGoal State Reached!")
            break

        neighbours = get_neighbours(current)

        best_state = current
        best_cost = current_cost

        print("\nNeighbour States:")

        for neighbour, pair in neighbours:
            cost = calculate_cost(neighbour)

            print(neighbour, "Cost:", cost)

            if cost < best_cost:
                best_cost = cost
                best_state = neighbour

        # Stop if no better neighbour is found
        if best_state == current:
            print("\nNo better neighbour found!")
            break

        current = best_state


# Run the program
hill_climbing()
